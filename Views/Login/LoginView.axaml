<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PasswordManager.Views.Login.LoginView">
  <Grid>
    <StackPanel Classes="Wrapper">
      <Label Classes="Input"  x:Name="labelMasterKey"/>
      <TextBox Classes="Input" x:Name="inputMasterKey" PasswordChar="*"/>
      <Button Classes="Input" Content="Done" Click="DoneClick" IsDefault="True"/>
      <CheckBox Content="Показать пароль" IsCheckedChanged="CheckBoxChanged"/>           
    </StackPanel>
  </Grid>           
</UserControl>
