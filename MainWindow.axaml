<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PasswordManager.MainWindow"
        Title="PasswordManager"

        TransparencyLevelHint="AcrylicBlur"
        Background="#3C000000"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

        <Window.Styles>
            <StyleInclude Source="/Styles/MainWindowStyles.axaml" />
        </Window.Styles>

        <DockPanel>
            <!--Шапка приложения-->
            <Border DockPanel.Dock="Top" 
                    Height="30" 
                    Background="#1E1E1E" 
                    PointerPressed="HeaderPointerPressed">
                <TextBlock Text="PasswordManager" 
                        Foreground="#ACFFFFFF" 
                        VerticalAlignment="Center" 
                        Margin="40,0,0,0"
                        />
            </Border>
            <!--Основной код-->
            <Grid>
                 <StackPanel Classes="Wrapper">
                    <Label Classes="Input" Content="Введите мастер-пароль"/>
                    <TextBox Classes="Input" x:Name="inputMasterKey"/>
                    <Button Classes="Input" Content="Done" Click="DoneClick" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </DockPanel>
</Window>
